# Relative paths below resolve against the directory containing this file,
# not the directory you launch mahamantri from.

# "claude" (the default): mahamantri runs a main Claude Code session and a
# worker per piece of work. "opencode": one main session on an opencode
# server (configured below), no workers. See the README.
mode: claude

# The projects this system works on, one directory per project.
workspace: "../repos"
# Samrajya's memory of the work. Empty: no memory.
brain: "../brain"
# Where Samrajya tells you about itself (a stuck or failing main session),
# e.g. "telegram:<your chat id>". Empty: only the log.
home: ""

# Linear: comments that mention Senapati or reply in its threads. On when
# signingSecret is set.
linear:
  signingSecret: ""          # or set LINEAR_SIGNING_SECRET
  listenAddr: ":8080"        # where Linear's webhook is delivered
  botUserID: ""              # Senapati's own Linear user id (actor.id on its comments)
  botName: "Senapati"
  botHandle: ""              # what comments @-mention it as, without the @
  # A Linear API key of Senapati's account, or set LINEAR_API_KEY. Needed to
  # reply; with it each ping also gets a reaction (receivedEmoji, default 👀),
  # Senapati's status shows problems, and a ping left waiting is answered.
  apiKey: ""
  nudgeAfter: "15m"          # 0s: never
  trustedUserIDs: []         # Linear users who may ask for work; empty = everyone
  # startsWork: true         # a trusted ping on a new issue starts a worker

# Telegram: a bot you write to. On when botToken is set. Give each mahamantri
# a bot of its own.
telegram:
  botToken: ""               # or set TELEGRAM_BOT_TOKEN
  trustedUserIDs: []         # your Telegram user id; everyone else is ignored
  # chatIDs: []              # group chats to listen in too
  # nudgeAfter: "2m"
  # startsWork: false        # chats go to the main session, which dispatches

bridge:
  listenAddr: "127.0.0.1:4098"  # the API the sessions' tools use; loopback only
  store: mahamantri.db
  # discoveryFile: ""        # default $XDG_STATE_HOME/samrajya/bridge.json
  # mainDirectory: ""        # where sessions run; default: the workspace

# The sessions mode claude runs. See ../docs/design/agents.md.
agents:
  maxWorkers: 2              # workers running at once; the rest wait
  remoteControl: "Samrajya"  # the main session's Remote Control name
  workerRemoteControl: false # Remote Control for each worker too
  # mainArgs: ["--model", "sonnet"]
  # workerArgs: []
  # namePrefix: samrajya     # session names; strays with it are stopped
  # mainRole: ../senapati/main.md
  # workerRole: ../senapati/worker.md

# Samrajya changing itself: sessions work on its codebase like any project,
# and a trusted person approves deploying it ("approve R<n>" in the
# conversation). Run from a release, not the checkout: see
# ../docs/design/self-update.md.
# selfUpdate:
#   code: repos/samrajya             # the codebase (a git repository)
#   service: samrajya-mahamantri     # the systemd user service
#   # script: default: scripts/samrajya of the running release

# mode: opencode only.
opencode:
  serverURL: "http://localhost:4096"
  password: ""               # or set OPENCODE_SERVER_PASSWORD
  agent: ""
  model:
    providerID: ""
    id: ""
  # instructionsFile: ../senapati/senapati.md
