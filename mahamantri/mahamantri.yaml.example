# Relative paths below resolve against the directory containing this file,
# not the directory you launch mahamantri from.
opencode:
  serverURL: http://localhost:4096
  # `opencode serve` picks a NEW password every start. Either paste the current
  # one here (edits are picked up while mahamantri runs), or pin it once with
  #   OPENCODE_SERVER_PASSWORD=<fixed> opencode serve --port 4096
  # and never touch this again. Empty falls back to $OPENCODE_SERVER_PASSWORD.
  password: ""
linear:
  signingSecret: ""          # empty falls back to $LINEAR_SIGNING_SECRET
  listenAddr: "127.0.0.1:45821"
  # Senapati's own Linear account - required. Senapati is pinged for exactly
  # two things: a person's comment that @-mentions botHandle, and a person's
  # reply in a comment thread Senapati has written in (recognised by
  # botUserID). Every other delivery - issue edits, status, labels,
  # assignment, its own comments - is logged and dropped. botHandle is often
  # the local part of the account's email, not its display name; botUserID is
  # actor.id on any comment Senapati made, in mahamantri.log.
  botUserID: ""
  botName: ""                # defaults to "Senapati"
  botHandle: ""
attention:
  listenAddr: "127.0.0.1:4097"
  registryFile: "./mahamantri-registry.json"
state:
  senapatiFile: "./mahamantri-senapati.json"   # holds the current + retired Senapati session IDs
  linearThreadsFile: "./mahamantri-linear-threads.json"   # comment threads Senapati has written in
sainik:
  directory: ""              # working directory for sainik sessions (the repo they work in)
  defaultModel: ""           # provider/id used when Senapati names none, e.g. openai/gpt-6-sol
  agent: ""                  # opencode agent for sainiks, optional
# Models Senapati may choose for a sainik, with guidance it reads in its briefing.
models: []
#  - id: openai/gpt-6-sol
#    credits: scarce
#    use: hard reasoning and tricky debugging
senapati:
  agent: ""                  # opencode custom-agent name, optional
  directory: ""              # optional session working directory
  # The model Senapati runs on. Leave it unset and sessions made through the
  # API use the opencode SERVER's default model (often a free one) - not the
  # one you pick in the opencode TUI, which is stored client-side.
  model:
    providerID: ""           # e.g. openai
    id: ""                   # e.g. gpt-6-sol
  # Role text sent to Senapati as its first message (with its identity and the
  # service URLs). Agent-file frontmatter is ignored.
  instructionsFile: "../senapati/senapati.md"
  rotationThreshold: 0.4     # fraction of the model's context limit that triggers a new Senapati session
  # Senapati's tools are restricted to curl to mahamantri, jq and the Linear
  # MCP tools (linear_*), so the work can only go to a sainik. Rules added here
  # come after those (the last matching rule wins); "ask" is not allowed -
  # nobody is there to answer it.
  extraPermissions: []
  #  - {action: "github_*", resource: "*", effect: allow}
