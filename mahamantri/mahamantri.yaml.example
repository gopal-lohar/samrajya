# Relative paths below resolve against the directory containing this file,
# not the directory you launch mahamantri from.

# What the main session runs on: "claude" (an interactive Claude Code session
# you start, with the Samrajya channel plugin) or "opencode" (a session on an
# opencode server, configured below). See the README.
mode: claude

# The projects this system works on, one directory per project.
workspace: "../repos"
# Samrajya's memory of the work. Empty: no memory.
brain: "../brain"

linear:
  signingSecret: ""          # or set LINEAR_SIGNING_SECRET
  listenAddr: ":8080"        # where Linear's webhook is delivered
  botUserID: ""              # Senapati's own Linear user id (actor.id on its comments)
  botName: "Senapati"
  botHandle: ""              # what comments @-mention it as, without the @

bridge:
  listenAddr: "127.0.0.1:4098"  # the API the main session's tools use; loopback only
  store: mahamantri.db
  # discoveryFile: ""        # default $XDG_STATE_HOME/samrajya/bridge.json
  # mainDirectory: ""        # where the main session runs; default: the workspace
  trustedUserIDs: []         # Linear users who may ask for work; empty = everyone

# mode: opencode only.
opencode:
  serverURL: "http://localhost:4096"
  password: ""               # or set OPENCODE_SERVER_PASSWORD
  agent: ""
  model:
    providerID: ""
    id: ""
  # instructionsFile: ../senapati/senapati.md
