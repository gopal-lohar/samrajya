# Relative paths below resolve against the directory containing this file,
# not the directory you launch mahamantri from.

# What the main session runs on: "claude" (an interactive Claude Code session
# you start, with the Samrajya channel plugin) or "opencode" (a session on an
# opencode server, configured below). See the README.
mode: claude

# The projects this system works on, one directory per project.
workspace: "../repos"
# Samrajya's memory of the work. Empty: no memory.
brain: "../brain"

linear:
  signingSecret: ""          # or set LINEAR_SIGNING_SECRET
  listenAddr: ":8080"        # where Linear's webhook is delivered
  botUserID: ""              # Senapati's own Linear user id (actor.id on its comments)
  botName: "Senapati"
  botHandle: ""              # what comments @-mention it as, without the @
  # A Linear API key of Senapati's account, or set LINEAR_API_KEY. Optional:
  # with it, each ping gets a reaction when stored (receivedEmoji, default 👀),
  # Senapati's Linear status shows when it is offline or blocked on you, and a
  # ping left waiting gets a comment mentioning its author.
  apiKey: ""
  nudgeAfter: "15m"           # 0s: never

bridge:
  listenAddr: "127.0.0.1:4098"  # the API the main session's tools use; loopback only
  store: mahamantri.db
  # discoveryFile: ""        # default $XDG_STATE_HOME/samrajya/bridge.json
  # mainDirectory: ""        # where the main session runs; default: the workspace
  trustedUserIDs: []         # Linear users who may ask for work; empty = everyone
  # Starts the main session when none is attached for 2 minutes (mode claude).
  # Claude Code ends a background session after hours idle.
  keepMain: ["../integrations/claude-channel/restart-main.sh", "--ensure"]

# Several sessions at once (mode claude): a main that talks to you and a
# worker per Linear issue, launched and supervised by mahamantri. Replaces
# bridge.keepMain. See ../docs/design/agents.md.
agents:
  enabled: false
  maxWorkers: 2              # workers running at once; the rest wait
  remoteControl: "Samrajya"  # the main session's Remote Control name
  workerRemoteControl: false # Remote Control for each worker too
  # mainArgs: ["--model", "sonnet"]
  # workerArgs: []
  # namePrefix: samrajya     # session names; strays with it are stopped
  # mainRole: ../senapati/main.md
  # workerRole: ../senapati/worker.md

# mode: opencode only.
opencode:
  serverURL: "http://localhost:4096"
  password: ""               # or set OPENCODE_SERVER_PASSWORD
  agent: ""
  model:
    providerID: ""
    id: ""
  # instructionsFile: ../senapati/senapati.md
