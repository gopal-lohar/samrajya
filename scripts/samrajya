#!/usr/bin/env bash
# Run Samrajya: one command for everything you do to it.
#
#   samrajya status         the service, the sessions and what waits
#   samrajya restart        restart mahamantri; sessions reattach by themselves
#   samrajya restart-main   stop the main session; mahamantri starts a new one
#   samrajya build          test and build mahamantri (to mahamantri.next) and the plugin
#   samrajya deploy REF     build and test a commit of the codebase as a release,
#                           switch to it and restart; put the running release
#                           back if Samrajya does not come up on it
#   samrajya update         deploy the codebase's HEAD
#   samrajya release REF    build and test a release without deploying it
#   samrajya install-plugin install the running release's plugin for the sessions
#   samrajya cutover        switch a setup from before surfaces to this version:
#                           convert the config, install the plugin, stop the old
#                           main session, start the new mahamantri. Backs up first.
#   samrajya rollback       undo the last cutover, from its backup
#
# mahamantri runs as the systemd user service $SAMRAJYA_SERVICE (default
# samrajya-mahamantri); its unit names the binary and the config. Releases
# live in releases/<commit> under the service's working directory, with
# `current` pointing at the one that runs; the codebase is $SAMRAJYA_CODE
# (default repos/samrajya there).
#
# With $SAMRAJYA_REPORT set (mahamantri sets it when it runs an approved
# change), output goes to the report's .log and how it went is written to
# the report as {"ok": ..., "text": ...}.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
service=${SAMRAJYA_SERVICE:-samrajya-mahamantri}
state=${XDG_STATE_HOME:-$HOME/.local/state}/samrajya
export PATH="$HOME/.local/bin:${PNPM_HOME:-$HOME/.local/share/pnpm}/bin:${PNPM_HOME:-$HOME/.local/share/pnpm}:/usr/local/go/bin:/usr/local/bin:$PATH"

die() { echo "samrajya: $*" >&2; exit 1; }
say() { echo "== $*"; }

# result is what the report says when the command succeeds.
result=""
if [[ -n ${SAMRAJYA_REPORT:-} ]]; then
  exec >>"${SAMRAJYA_REPORT%.json}.log" 2>&1
  echo "== $(date -u +%FT%TZ) samrajya $*"
  write_report() {
    local code=$1 text
    if [[ $code == 0 ]]; then
      text=${result:-done}
    else
      text="${result:+$result

}Last lines of ${SAMRAJYA_REPORT%.json}.log:
$(tail -n 25 "${SAMRAJYA_REPORT%.json}.log")"
    fi
    jq -n --argjson ok "$([[ $code == 0 ]] && echo true || echo false)" --arg text "$text" '{ok: $ok, text: $text}' >"$SAMRAJYA_REPORT.tmp"
    mv "$SAMRAJYA_REPORT.tmp" "$SAMRAJYA_REPORT"
  }
  trap 'write_report $?' EXIT
fi

# The binary, its directory and the config, from the service's unit.
unit() {
  local exec dir
  exec=$(systemctl --user show -p ExecStart --value "$service" | sed -n 's/.*argv\[\]=\([^;]*\);.*/\1/p')
  dir=$(systemctl --user show -p WorkingDirectory --value "$service")
  exec=$(sed 's/[[:space:]]*$//' <<<"$exec")
  [[ -n $exec ]] || die "no service $service (systemctl --user cat $service)"
  bin=${exec%% *}
  cfg=${exec#* }
  [[ $cfg == "$exec" ]] && cfg=mahamantri.yaml
  [[ $cfg == /* ]] || cfg=$dir/$cfg
  [[ $bin == /* ]] || bin=$dir/$bin
}

discovery() { cat "${SAMRAJYA_BRIDGE_FILE:-$state/bridge.json}" 2>/dev/null; }

bridge_status() {
  local d url token
  d=$(discovery) || return 1
  url=$(jq -r .url <<<"$d")
  token=$(jq -r .token <<<"$d")
  curl -fsS -H "Authorization: Bearer $token" "$url/v1/status"
}

main_dir() {
  "$bin" check "$cfg" 2>/dev/null | sed -n 's/.*sessions in \(.*\)$/\1/p'
}

cmd_status() {
  unit
  systemctl --user --no-pager status "$service" | sed -n '1,3p'
  if st=$(bridge_status); then
    jq -r '"main session: " + (if .main.live then "attached" else "not attached" end),
      "surfaces: " + (.surfaces | join(", ")),
      "pending: \(.recovery.pending | length), open tasks: \(.recovery.openTasks | length), unresolved actions: \(.recovery.unresolvedActions | length)"' <<<"$st"
  else
    echo "bridge: not answering"
  fi
  local dir
  dir=$(main_dir)
  [[ -n $dir ]] || return 0
  dir=$(realpath "$dir")
  claude agents --json | jq -r --arg dir "$dir" '.[] | select(.pid != null and .cwd == $dir) | "session \(.name) (\(.id))"'
}

cmd_restart() {
  systemctl --user restart "$service"
  sleep 3
  systemctl --user --no-pager status "$service" | sed -n '1,3p'
  if [[ -n ${SAMRAJYA_REPORT:-} ]]; then
    wait_for_bridge || { result="mahamantri did not come back after the restart"; exit 1; }
    wait_for_main || { result="Samrajya restarted, but the main session has not reattached within 3 minutes"; exit 1; }
    result="Samrajya restarted; the main session reattached."
  fi
}

cmd_restart_main() {
  unit
  local dir id
  dir=$(realpath "$(main_dir)")
  id=$(claude agents --json | jq -r --arg dir "$dir" '[.[] | select(.pid != null and .cwd == $dir and (.name | test("-main-g[0-9]+$")))][0].id // empty')
  [[ -n $id ]] || die "no main session is running; mahamantri starts one within a minute"
  local gen
  gen=$(bridge_status 2>/dev/null | jq -r '.main.generation // 0') || gen=0
  claude stop "$id"
  echo "stopped $id; mahamantri notices within two minutes and starts a new main session"
  if [[ -n ${SAMRAJYA_REPORT:-} || ${1:-} == --wait ]]; then
    wait_for_new_main "$gen" || { result="the main session was stopped, but no new one attached within 5 minutes"; exit 1; }
    result="The main session was replaced; the new one attached."
  fi
}

# wait_for_new_main waits for a main session attached after attachment gen.
wait_for_new_main() {
  local gen=$1 i st
  for i in $(seq 1 60); do
    if st=$(bridge_status 2>/dev/null) && jq -e --argjson g "$gen" '.main.live and .main.generation > $g' <<<"$st" >/dev/null; then
      echo "a new main session attached"
      return 0
    fi
    sleep 5
  done
  return 1
}

cmd_build() {
  unit
  say "testing mahamantri"
  (cd "$root/mahamantri" && go vet ./... && go test ./...)
  say "building $(dirname "$bin")/mahamantri.next"
  (cd "$root/mahamantri" && go build -o "$(dirname "$bin")/mahamantri.next" .)
  say "testing and bundling the plugin"
  (cd "$root/integrations/claude-channel" && pnpm test >/dev/null && pnpm bundle >/dev/null)
  "$(dirname "$bin")/mahamantri.next" check "$cfg" || echo "(the config needs converting: samrajya cutover)"
}

# install_plugin makes the main directory's sessions load the plugin of
# the release in $2 (default this checkout). `claude plugin update --scope local` may update another
# directory's entry instead of this one, so it only fills the plugin cache;
# the entries are then set by hand: this directory's to the new version,
# every other one as it was.
install_plugin() {
  local dir=$1 src=${2:-$root} want f=~/.claude/plugins/installed_plugins.json before
  want=$(jq -r .version "$src/integrations/claude-channel/plugin/.claude-plugin/plugin.json")
  before=$(mktemp)
  cp "$f" "$before"
  claude plugin marketplace update samrajya >/dev/null
  (cd "$dir" && claude plugin update samrajya@samrajya --scope local >/dev/null 2>&1) || true
  local cache=~/.claude/plugins/cache/samrajya/samrajya/$want
  [[ -f $cache/server.mjs ]] || die "the plugin cache has no $want ($cache): run 'claude plugin update samrajya@samrajya' and retry"
  jq --slurpfile before "$before" --arg dir "$dir" --arg v "$want" --arg path "$cache" --arg now "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" '
    .plugins["samrajya@samrajya"] = (
      [$before[0].plugins["samrajya@samrajya"][] | select(.projectPath != $dir)]
      + [(($before[0].plugins["samrajya@samrajya"][] | select(.projectPath == $dir)) // {scope: "local", projectPath: $dir, installedAt: $now})
         + {version: $v, installPath: $path, lastUpdated: $now}])' "$f" >"$f.tmp"
  mv "$f.tmp" "$f"
  rm -f "$before"
  echo "plugin $want installed for $dir"
}

wait_for_bridge() {
  local i
  for i in $(seq 1 30); do
    if systemctl --user is-active --quiet "$service" && bridge_status >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_main() {
  local i
  for i in $(seq 1 36); do
    if bridge_status 2>/dev/null | jq -e .main.live >/dev/null; then
      echo "main session attached"
      return 0
    fi
    sleep 5
  done
  return 1
}

# home is the service's working directory: the config, the releases and
# (by default) the codebase live there.
paths() {
  if [[ -n ${SAMRAJYA_HOME:-} ]]; then
    home=$SAMRAJYA_HOME
  else
    unit
    home=$(systemctl --user show -p WorkingDirectory --value "$service")
  fi
  releases=$home/releases
  current=$home/current
  code=${SAMRAJYA_CODE:-$home/repos/samrajya}
  [[ -d $code/.git ]] || code=$root
  [[ -d $code/.git ]] || die "no codebase: set SAMRAJYA_CODE to Samrajya's git repository"
}

plugin_version() { jq -r .version "$1/integrations/claude-channel/plugin/.claude-plugin/plugin.json" 2>/dev/null || echo none; }

# build_release builds and tests commit $1 of the codebase into $2.
build_release() {
  local sha=$1 out=$2 tmp
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN
  mkdir -p "$tmp/src" "$tmp/rel/mahamantri" "$tmp/rel/integrations/claude-channel"
  git -C "$code" archive --format=tar "$sha" | tar -x -C "$tmp/src"
  say "testing mahamantri at ${sha:0:10}"
  (cd "$tmp/src/mahamantri" && go vet ./... && go test ./... && go build -o "$tmp/rel/mahamantri/mahamantri" .)
  say "testing and bundling the plugin"
  (cd "$tmp/src/integrations/claude-channel" && pnpm install --frozen-lockfile --prefer-offline --reporter=silent && pnpm test >/dev/null && pnpm bundle >/dev/null)
  cp -a "$tmp/src/integrations/.claude-plugin" "$tmp/rel/integrations/"
  cp -a "$tmp/src/integrations/claude-channel/plugin" "$tmp/rel/integrations/claude-channel/"
  cp -a "$tmp/src/senapati" "$tmp/src/scripts" "$tmp/rel/"
  echo "$sha" >"$tmp/rel/RELEASE"
  mkdir -p "$(dirname "$out")"
  rm -rf "$out.partial"
  mv "$tmp/rel" "$out.partial"
  mv -T "$out.partial" "$out"
}

switch_to() { ln -sfn "$1" "$current.next" && mv -T "$current.next" "$current"; }

cmd_deploy() {
  local ref=${1:-} sha rel prev dir snapshot replace_main=no gen
  [[ -n $ref ]] || die "usage: samrajya deploy REF"
  paths
  unit
  sha=$(git -C "$code" rev-parse --verify --quiet "$ref^{commit}") || die "$ref is not a commit of $code"
  rel=$releases/$sha
  prev=$(readlink -f "$current" 2>/dev/null || true)
  [[ $prev != "$rel" ]] || die "${sha:0:10} is already the running release"
  if [[ ! -x $rel/mahamantri/mahamantri ]]; then
    build_release "$sha" "$rel" || { result="${sha:0:10} did not build or its tests failed; nothing was changed"; exit 1; }
  fi
  "$rel/mahamantri/mahamantri" check "$cfg" || { result="the config does not load with ${sha:0:10}; nothing was changed"; exit 1; }
  if [[ -n $prev ]]; then
    if ! diff -rq "$prev/integrations/claude-channel/plugin" "$rel/integrations/claude-channel/plugin" >/dev/null 2>&1; then
      if [[ $(plugin_version "$prev") == "$(plugin_version "$rel")" ]]; then
        result="the plugin changed but its version did not ($(plugin_version "$rel")): bump it in plugin.json, or sessions keep the old one. Nothing was changed"
        exit 1
      fi
      replace_main=yes
    fi
    diff -rq "$prev/senapati" "$rel/senapati" >/dev/null 2>&1 || replace_main=yes
  fi
  dir=$(realpath "$(main_dir)")
  snapshot=$(mktemp)
  cp ~/.claude/plugins/installed_plugins.json "$snapshot"

  say "switching to ${sha:0:10} (from ${prev:+$(basename "$prev" | cut -c1-10)})"
  switch_to "$rel"
  if [[ $(plugin_version "$prev") != "$(plugin_version "$rel")" ]]; then
    install_plugin "$dir" "$rel"
  fi
  gen=$(bridge_status 2>/dev/null | jq -r '.main.generation // 0') || gen=0
  systemctl --user restart "$service"
  local ok=yes
  if ! wait_for_bridge; then
    ok=no
  elif [[ $replace_main == yes ]]; then
    say "the role or plugin changed: replacing the main session"
    cmd_restart_main_quiet
    wait_for_new_main 0 || ok=no
  else
    wait_for_main || ok=no
  fi
  if [[ $ok == no ]]; then
    if [[ -z $prev ]]; then
      result="Samrajya did not come up on ${sha:0:10}, and there is no earlier release to put back"
      exit 1
    fi
    say "Samrajya did not come up on ${sha:0:10}: putting $(basename "$prev" | cut -c1-10) back"
    journalctl --user -u "$service" -n 30 --no-pager || true
    switch_to "$prev"
    cp "$snapshot" ~/.claude/plugins/installed_plugins.json
    # A crash loop may have hit systemd's start limit.
    systemctl --user reset-failed "$service" 2>/dev/null || true
    systemctl --user restart "$service"
    wait_for_bridge || true
    [[ $replace_main == yes ]] && cmd_restart_main_quiet
    result="Samrajya did not come up on ${sha:0:10} (see the log below), so the earlier release $(basename "$prev" | cut -c1-10) was put back"
    rm -f "$snapshot"
    exit 1
  fi
  rm -f "$snapshot"
  # Keep the running release, the one before and the three newest others.
  ls -1dt "$releases"/*/ 2>/dev/null | sed 's#/$##' | grep -vxF -e "$rel" -e "$prev" | tail -n +4 | xargs -r rm -rf
  result="Deployed ${sha:0:10}: Samrajya is running on it$([[ $replace_main == yes ]] && echo ", with a new main session"). The release before, $(basename "${prev:-none}" | cut -c1-10), is kept: it can be deployed back the same way."
  say "$result"
}

# cmd_restart_main_quiet stops the main session, if there is one, for
# mahamantri to start a new one.
cmd_restart_main_quiet() {
  local d id
  d=$(realpath "$(main_dir)")
  id=$(claude agents --json | jq -r --arg dir "$d" '[.[] | select(.pid != null and .cwd == $dir and (.name | test("-main-g[0-9]+$")))][0].id // empty')
  [[ -n $id ]] && claude stop "$id" || true
}

# cmd_release builds a release of REF without deploying it, and prints
# where (for setting a home up: SAMRAJYA_HOME=<home>).
cmd_release() {
  local ref=${1:-} sha
  [[ -n $ref ]] || die "usage: samrajya release REF"
  paths
  sha=$(git -C "$code" rev-parse --verify --quiet "$ref^{commit}") || die "$ref is not a commit of $code"
  [[ -x $releases/$sha/mahamantri/mahamantri ]] || build_release "$sha" "$releases/$sha"
  echo "$releases/$sha"
}

# cmd_install_plugin installs the running release's plugin for the main
# directory.
cmd_install_plugin() {
  paths
  unit
  install_plugin "$(realpath "$(main_dir)")" "$(readlink -f "$current")"
}

cmd_update() {
  paths
  cmd_deploy "$(git -C "$code" rev-parse HEAD)"
}

cmd_cutover() {
  unit
  local next ts backup dir
  next=$(dirname "$bin")/mahamantri.next
  [[ -x $next ]] || die "build first: samrajya build"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  backup=$state/backup-$ts
  mkdir -p "$backup"
  chmod 700 "$backup"

  say "converting the config"
  "$next" migrate-config "$cfg" "$cfg.next"
  dir=$(realpath "$("$next" check "$cfg.next" | sed -n 's/.*sessions in \(.*\)$/\1/p')")
  store=$("$next" check "$cfg.next" | sed -n 's/.*store \(.*\), sessions in.*/\1/p')

  say "backing up to $backup"
  cp -p "$bin" "$backup/mahamantri"
  cp -p "$cfg" "$backup/config.yaml"
  echo "$cfg" >"$backup/config.path"
  echo "$bin" >"$backup/binary.path"
  echo "$dir" >"$backup/main-directory"
  jq --arg dir "$dir" '.plugins["samrajya@samrajya"][] | select(.projectPath == $dir)' ~/.claude/plugins/installed_plugins.json >"$backup/plugin.json"

  say "installing the plugin"
  install_plugin "$dir"

  say "stopping mahamantri and the old main session"
  systemctl --user stop "$service"
  cp -p "$store" "$backup/store.db"
  # The old main session is not supervised, and would keep acting through
  # its own tools: stop it (by the name the old restart script gave it).
  claude agents --json | jq -r --arg dir "$dir" --arg name "${SAMRAJYA_OLD_MAIN:-samrajya}" \
    '.[] | select(.pid != null and .cwd == $dir and .name == $name) | "\(.id)\t\(.name)"' |
    while IFS=$'\t' read -r id name; do
      echo "stopping $name ($id)"
      claude stop "$id" || true
    done

  say "starting the new mahamantri"
  mv "$next" "$bin"
  mv "$cfg.next" "$cfg"
  systemctl --user start "$service"
  echo "$backup" >"$state/last-cutover"
  if wait_for_main; then
    say "done. Roll back with: samrajya rollback"
  else
    echo "the main session has not attached within 3 minutes: check samrajya status and $(dirname "$cfg")/mahamantri.log; roll back with: samrajya rollback" >&2
    exit 1
  fi
}

cmd_rollback() {
  local backup
  backup=$(cat "$state/last-cutover" 2>/dev/null) || die "no cutover to roll back"
  [[ -d $backup ]] || die "backup $backup is gone"
  local bin cfg dir store
  bin=$(cat "$backup/binary.path")
  cfg=$(cat "$backup/config.path")
  dir=$(cat "$backup/main-directory")
  store=$("$bin" check "$cfg" | sed -n 's/.*store \(.*\), sessions in.*/\1/p')

  say "stopping mahamantri and the sessions it ran"
  systemctl --user stop "$service"
  local prefix
  prefix=$(sed -n 's/^ *namePrefix: *"\{0,1\}\([A-Za-z0-9-]*\).*/\1/p' "$cfg" | head -1)
  claude agents --json | jq -r --arg dir "$dir" --arg p "${prefix:-samrajya}-" \
    '.[] | select(.pid != null and .cwd == $dir and (.name | startswith($p))) | "\(.id)\t\(.name)"' |
    while IFS=$'\t' read -r id name; do
      echo "stopping $name ($id)"
      claude stop "$id" || true
    done

  say "keeping the store, marked for the old mahamantri"
  # Everything received since the cutover stays: the old main gets it all.
  "$bin" downgrade-store "$store"

  say "restoring the binary, the config and the plugin"
  cp -p "$bin" "$bin.after-cutover"
  cp -p "$backup/mahamantri" "$bin"
  cp -p "$cfg" "$cfg.after-cutover"
  cp -p "$backup/config.yaml" "$cfg"
  if [[ -s $backup/plugin.json ]]; then
    local f=~/.claude/plugins/installed_plugins.json
    jq --arg dir "$dir" --slurpfile old "$backup/plugin.json" \
      '.plugins["samrajya@samrajya"] |= map(if .projectPath == $dir then $old[0] else . end)' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  fi

  systemctl --user start "$service"
  rm -f "$state/last-cutover"
  say "rolled back; the old mahamantri starts its main session within a few minutes"
}

case ${1:-} in
status) cmd_status ;;
restart) cmd_restart ;;
restart-main) shift; cmd_restart_main "$@" ;;
build) cmd_build ;;
deploy) shift; cmd_deploy "$@" ;;
release) shift; cmd_release "$@" ;;
install-plugin) cmd_install_plugin ;;
update) cmd_update ;;
cutover) cmd_cutover ;;
rollback) cmd_rollback ;;
*) sed -n '2,/^set -e/{/^set -e/d;p}' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
