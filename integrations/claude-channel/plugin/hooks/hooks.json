{
  "description": "Tell Samrajya when a session hits the usage limit and when an agent's turns start and end, and wait for new messages for the agent between turns, waking it when they arrive",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/server.mjs",
              "--stop-failure"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/server.mjs",
              "--turn",
              "start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/server.mjs",
              "--wait"
            ],
            "async": true,
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
